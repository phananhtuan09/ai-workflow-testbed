# Ports for the API and the Vite dev server. Change both to run a second copy side by side.
API_PORT=3001
WEB_PORT=5173
# Where the JSON database lives. Use a separate directory per running copy.
DATA_DIR=.data
# Test-only: enables POST /api/test/reset. Never enable outside local or CI runs.
TEST_MODE=0
# Test-only: freezes the server clock, e.g. 2026-02-01T08:00:00.000Z
FIXED_NOW=
